rules_version = '2';
// قواعد أمان اجتماع شباب ثانوي — الكنيسة الرسولية ريدة
// الحضور بيتحسب بساعة سيرفر Firebase مش ساعة الموبايل، فمحدش يقدر يغش بتغيير الوقت.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'rafatsaeed719@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // مواعيد الاجتماع وتوقيت القاهرة محفوظين في config/app (قائد الاجتماع بيغيرهم من التطبيق)
    function cfg() {
      return exists(/databases/$(database)/documents/config/app)
        ? get(/databases/$(database)/documents/config/app).data
        : {};
    }
    function local() { return request.time + duration.value(cfg().get('utcOffset', 3), 'h'); }
    function mins() { return local().hours() * 60 + local().minutes(); }
    function dayKey() {
      return string(local().year()) + '-' + string(local().month()) + '-' + string(local().day());
    }
    // ترقيم الأيام: الاتنين = 1 ... الجمعة = 5 ... الحد = 7
    function meetingOpen() {
      return local().dayOfWeek() == cfg().get('day', 5)
        && mins() >= cfg().get('start', 1140) && mins() < cfg().get('end', 1260);
    }
    function validChoice(d) {
      return (d.color == 'green'  && d.points == 10 && mins() < cfg().get('greenEnd', 1145))
          || (d.color == 'yellow' && d.points == 5  && mins() < cfg().get('yellowEnd', 1180))
          || (d.color == 'red'    && d.points == 0  && mins() < cfg().get('end', 1260));
    }
    // مكان الاجتماع: لو مفعّل، الإحداثيات اللي في التسجيل لازم تكون جوه الدايرة
    function nearMeeting(d) {
      let c = cfg();
      return c.get('geoOn', false) != true || (
        d.lat is number && d.lng is number &&
        math.pow((d.lat - c.lat) * 111320, 2) + math.pow((d.lng - c.lng) * 111320 * c.cosLat, 2)
          <= math.pow(c.radius, 2));
    }
    function validConfig(c) {
      return c.get('utcOffset', 3) is int && c.get('utcOffset', 3) >= 2 && c.get('utcOffset', 3) <= 3
        && c.get('day', 5) is int && c.get('day', 5) >= 1 && c.get('day', 5) <= 7
        && c.get('start', 1140) is int && c.get('end', 1260) is int
        && c.get('greenEnd', 1145) is int && c.get('yellowEnd', 1180) is int
        && c.get('start', 1140) >= 0 && c.get('end', 1260) <= 1440
        && c.get('start', 1140) < c.get('greenEnd', 1145)
        && c.get('greenEnd', 1145) <= c.get('yellowEnd', 1180)
        && c.get('yellowEnd', 1180) <= c.get('end', 1260)
        && (c.get('geoOn', false) != true || (
              c.lat is number && c.lng is number && c.cosLat is number
              && c.cosLat > 0 && c.cosLat <= 1
              && c.radius is int && c.radius >= 30 && c.radius <= 1000));
    }

    match /config/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() && validConfig(request.resource.data);
    }

    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 80;
      // القائد يضيف ويعدل ويحذف أعضاء (زي اللي معندهمش موبايل)
      allow create, update, delete: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      // الشاب بيسجل لنفسه مرة واحدة في اليوم، في الوقت المفتوح بس
      allow create: if signedIn()
        && meetingOpen()
        && id == dayKey() + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day == dayKey()
        && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['uid', 'day', 'color', 'points', 'at', 'lat', 'lng', 'acc'])
        && validChoice(request.resource.data)
        && nearMeeting(request.resource.data);
      // المدير/الخادم يقدر يسجل يدوي أو يعدل أو يمسح
      allow create, update, delete: if isAdmin();
    }

    match /tasks/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /submissions/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && id == request.resource.data.taskId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.points == 0
        && request.resource.data.answer is string && request.resource.data.answer.size() <= 4000
        && get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.active == true;
      allow update, delete: if isAdmin();
    }

    match /photos/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /events/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // رسائل قائد الاجتماع (نص/صورة/فيديو/لينك) — الفيديو مقسم أجزاء في chunks
    match /messages/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /chunks/{n} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    // تنبيه صغير بآخر رسالة: الموبايل بيقراه في الخلفية عشان يطلع الإشعار
    match /meta/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
